on init
    chown system graphics /sys/devices/platform/soc/soc:qcom,dsi-display-primary/hbm
    chmod 0666 /sys/devices/platform/soc/soc:qcom,dsi-display-primary/hbm

service vendor.livedisplay-hal-2-1 /vendor/bin/hw/vendor.lineage.livedisplay@2.1-service.nubia
    class late_start
    user system
    group system
